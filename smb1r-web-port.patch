diff --git a/addons/mod_loader/mod_loader_store.gd b/addons/mod_loader/mod_loader_store.gd
index c3640b4..c4a999c 100644
--- a/addons/mod_loader/mod_loader_store.gd
+++ b/addons/mod_loader/mod_loader_store.gd
@@ -117,14 +117,43 @@ var has_feature := {
 # =============================================================================
 
 func _init():
+	# Web: stay inert (as before) unless the player imported mods from Settings.
+	# The loader writes to user://logs and user://mods, which don't exist on a
+	# fresh browser profile, so create them before anything is logged.
+	var web := OS.has_feature("web")
+	if web:
+		if not _web_should_load_mods():
+			ml_options = ModLoaderOptionsProfile.new()
+			ml_options.enable_mods = false
+			return
+		DirAccess.make_dir_recursive_absolute("user://logs")
+		DirAccess.make_dir_recursive_absolute("user://mods")
 	_update_ml_options_from_options_resource()
 	_update_ml_options_from_cli_args()
+	if web:
+		# The options resource has a "web" override that turns mods off; imported
+		# mods are the one case where we want them on.
+		ml_options.enable_mods = true
 	_configure_logger()
 	# ModLoaderStore is passed as argument so the cache data can be loaded on _init()
 	_ModLoaderCache.init_cache(self)
 
 
+## Web: true when mod zips were imported into user://mods, unless the page was
+## opened with ?nomods (safe mode, in case an imported mod breaks startup).
+func _web_should_load_mods() -> bool:
+	var query = JavaScriptBridge.eval("window.location.search", true)
+	if query is String and "nomods" in query:
+		return false
+	for file_name in DirAccess.get_files_at("user://mods"):
+		if file_name.to_lower().ends_with(".zip"):
+			return true
+	return false
+
+
 func _exit_tree() -> void:
+	if OS.has_feature("web") and not ml_options.enable_mods:
+		return
 	# Save the cache to the cache file.
 	_ModLoaderCache.save_to_file()
 
