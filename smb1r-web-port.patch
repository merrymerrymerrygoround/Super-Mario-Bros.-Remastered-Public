+class_name TouchLayoutRow
+extends RefCounted
+
+const SELECTABLE_BUTTON = preload("res://Scenes/Parts/SelectableOptionButton.tscn")
+const VIDEO_PATH := "PanelContainer/MarginContainer/VBoxContainer/Video"
+
+
+static func install(menu: Control) -> void:
+	var video: Node = menu.get_node_or_null(VIDEO_PATH)
