+var _drag_pointer := NO_POINTER
+var _drag_grab := Vector2.ZERO
+var _edit_canvas: EditCanvas = null
+var _tool_rects := {}
+
+
+class TouchButton extends TouchScreenButton:
+	signal toggled(on: bool)
+
+	const COLOR_FILL := Color(1, 1, 1, 0.20)
+	const COLOR_FILL_HELD := Color(1, 1, 1, 0.45)
+	const COLOR_FILL_LATCHED := Color(1.0, 0.85, 0.2, 0.55)
+	const COLOR_EDGE := Color(1, 1, 1, 0.65)
+
+	var label := ""
+	var arrow := Vector2.ZERO
+	var round_shape := false
+	var button_size := Vector2.ZERO
+	var extra_actions: Array[StringName] = []
+	var toggle := false
+	var latched := false
+	var keep_actions: Array[StringName] = []
+	var keep_pressed := Callable()
+	var _held := false
+
+	func _ready() -> void:
+		pressed.connect(_on_pressed)
+		released.connect(_on_released)
+
+	func _on_pressed() -> void:
+		_held = true
+		for a in extra_actions:
+			_send(a, true)
+		if toggle:
+			latched = not latched
+			toggled.emit(latched)
+		queue_redraw()
+
+	func _on_released() -> void:
+		_held = false
+		for a in extra_actions:
+			if a in keep_actions and keep_pressed.is_valid() and keep_pressed.call():
+				continue
+			_send(a, false)
+		queue_redraw()
+
+	func release_all() -> void:
+		if _held:
+			_on_released()
+
+	static func _send(action: StringName, down: bool) -> void:
+		var ev := InputEventAction.new()
+		ev.action = action
+		ev.pressed = down
+		ev.strength = 1.0 if down else 0.0
+		Input.parse_input_event(ev)
+
+	func _draw() -> void:
+		var fill := COLOR_FILL_HELD if _held else COLOR_FILL
+		if toggle and latched:
+			fill = COLOR_FILL_LATCHED
+		if round_shape:
+			var r := button_size.x * 0.5
+			draw_circle(Vector2.ZERO, r, fill)
+			draw_arc(Vector2.ZERO, r, 0.0, TAU, 28, COLOR_EDGE, 1.0)
+		else:
+			var rect := Rect2(-button_size * 0.5, button_size)
+			draw_rect(rect, fill)
+			draw_rect(rect, COLOR_EDGE, false, 1.0)
+		if arrow != Vector2.ZERO:
+			var side := arrow.orthogonal()
+			draw_colored_polygon(PackedVector2Array([
+				arrow * 6.0, -arrow * 4.0 + side * 6.0, -arrow * 4.0 - side * 6.0
+			]), COLOR_EDGE)
+		elif label != "":
+			var font := ThemeDB.fallback_font
+			var size := font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, 8)
+			draw_string(font, Vector2(-size.x * 0.5, size.y * 0.3), label,
+					HORIZONTAL_ALIGNMENT_LEFT, -1, 8, Color(1, 1, 1, 0.9))
+
+
+class EditCanvas extends Node2D:
+	var draw_cb := Callable()
+
+	func _draw() -> void:
+		if draw_cb.is_valid():
+			draw_cb.call(self)
+
+
+func _ready() -> void:
+	print("[smb1r] TouchControls ready")
+	layer = LAYER
+	process_mode = Node.PROCESS_MODE_ALWAYS
+	_root = Node2D.new()
+	add_child(_root)
+	_edit_canvas = EditCanvas.new()
+	_edit_canvas.draw_cb = _draw_editor
+	_edit_canvas.visible = false
+	add_child(_edit_canvas)
+	_load_layout()
+	_build_buttons()
+	_layout()
+	Input.joy_connection_changed.connect(_on_joy_connection_changed)
+	_refresh()
+
+
+func _process(delta: float) -> void:
+	_check_layout()
+	if OS.has_feature("web"):
+		_portrait_timer -= delta
+		if _portrait_timer <= 0.0:
+			_portrait_timer = PORTRAIT_POLL_SECONDS
+			_set_portrait(_page_is_portrait())
+
+
+func _build_buttons() -> void:
+	_add(&"up", Vector2(24, 24), "", &"move_up_0", [&"ui_up"], true, Vector2.UP)
+	_add(&"down", Vector2(24, 24), "", &"move_down_0", [&"ui_down"], true, Vector2.DOWN)
+	_add(&"left", Vector2(24, 24), "", &"move_left_0", [&"ui_left"], true, Vector2.LEFT)
+	_add(&"right", Vector2(24, 24), "", &"move_right_0", [&"ui_right"], true, Vector2.RIGHT)
+	_add(&"b", Vector2(32, 32), "B", &"action_0", [&"run_0", &"ui_back"], false, Vector2.ZERO, true)
+	_add(&"a", Vector2(32, 32), "A", &"jump_0", [&"ui_accept"], false, Vector2.ZERO, true)
+	_add(&"lock", Vector2(26, 26), "LOCK", &"", [], false, Vector2.ZERO, true)
+	_add(&"select", Vector2(32, 14), "SEL", &"drop_item", [&"ui_select"])
+	_add(&"start", Vector2(32, 14), "START", &"pause", [])
+
+	var b: TouchButton = _by_id[&"b"]
+	b.keep_actions = [&"run_0"]
+	b.keep_pressed = func() -> bool: return _run_lock
+	var lock: TouchButton = _by_id[&"lock"]
+	lock.toggle = true
+	lock.toggled.connect(_set_run_lock)
+
+
+func _add(id: StringName, size: Vector2, label: String, action: StringName,
+		extras: Array[StringName], passby := false, arrow := Vector2.ZERO, round_shape := false) -> void:
+	var b := TouchButton.new()
+	b.action = String(action)
+	b.passby_press = passby
+	b.visibility_mode = TouchScreenButton.VISIBILITY_ALWAYS
+	b.shape_visible = false
+	b.label = label
+	b.arrow = arrow
+	b.round_shape = round_shape
+	b.button_size = size
+	b.extra_actions = extras
+	if round_shape:
+		var circle := CircleShape2D.new()
+		circle.radius = size.x * 0.5
+		b.shape = circle
+	else:
+		var rect := RectangleShape2D.new()
+		rect.size = size
+		b.shape = rect
+	_root.add_child(b)
+	_buttons.append(b)
+	_by_id[id] = b
+
+
+func _layout_signature() -> Vector4:
+	var vis := get_viewport().get_visible_rect().size
+	var win := Vector2(DisplayServer.window_get_size())
+	return Vector4(vis.x, vis.y, win.x, win.y)
+
+
+func _check_layout() -> void:
+	var key := _layout_signature()
+	if key != _layout_key:
+		_layout()
+
+
+func _control_scale(vis_size: Vector2) -> float:
+	var u := vis_size.y / BASE_HEIGHT
+	var win := Vector2(DisplayServer.window_get_size())
+	var boost := 1.0
+	if win.x > 0.0 and win.y > 0.0 and vis_size.x > 0.0 and vis_size.y > 0.0:
+		var px_per_unit := minf(win.x / vis_size.x, win.y / vis_size.y)
+		var dpr := maxf(1.0, DisplayServer.screen_get_scale())
+		var css_per_unit := px_per_unit / dpr
+		if css_per_unit > 0.0:
+			boost = clampf(TARGET_BUTTON_CSS_PX / (BASE_BUTTON * u * css_per_unit), 1.0, MAX_BOOST)
+	var k := u * boost
+	return minf(k, MAX_WIDTH_SHARE * vis_size.x / CLUSTER_WIDTH_UNITS)
+
+
+func _layout() -> void:
+	_layout_key = _layout_signature()
+	var vis := get_viewport().get_visible_rect()
+	var o := vis.position
+	var s := vis.size
+	var k := _control_scale(s)
+	var defaults := _default_positions(o, s, k)
+	for g in GROUPS:
+		_place_group(g, _group_pos(g, o, s, k, defaults), k * _group_scale(g))
+	if _editing and _edit_canvas != null:
+		_edit_canvas.queue_redraw()
+
+
+func _default_positions(o: Vector2, s: Vector2, k: float) -> Dictionary:
+	return {
+		&"dpad": o + Vector2(40.0 * k, s.y - 48.0 * k),
+		&"a": o + Vector2(s.x - 28.0 * k, s.y - 46.0 * k),
+		&"b": o + Vector2(s.x - 62.0 * k, s.y - 32.0 * k),
+		&"lock": o + Vector2(s.x - 62.0 * k, s.y - 68.0 * k),
+		&"select": o + Vector2(s.x * 0.5 - 18.0 * k, s.y - 14.0 * k),
+		&"start": o + Vector2(s.x * 0.5 + 18.0 * k, s.y - 14.0 * k),
+	}
+
+
+func _group_scale(g: StringName) -> float:
+	var c: Dictionary = _cfg.get(String(g), {})
+	return clampf(float(c.get("s", 1.0)), SCALE_MIN, SCALE_MAX)
+
+
+func _group_pos(g: StringName, o: Vector2, s: Vector2, k: float, defaults: Dictionary) -> Vector2:
+	var c: Dictionary = _cfg.get(String(g), {})
+	if c.is_empty():
+		return defaults[g]
+	var pos: Vector2 = defaults[g]
+	if c.has("x") and c.has("y"):
+		pos = o + Vector2(float(c["x"]) * s.x, float(c["y"]) * s.y)
+	return _clamp_group(g, pos, o, s, k * _group_scale(g))
+
+
+func _clamp_group(g: StringName, pos: Vector2, o: Vector2, s: Vector2, kk: float) -> Vector2:
+	var h: Vector2 = GROUP_HALF[g] * kk
+	return Vector2(clampf(pos.x, o.x + h.x, o.x + s.x - h.x),
+			clampf(pos.y, o.y + h.y, o.y + s.y - h.y))
+
+
+func _place_group(g: StringName, pos: Vector2, kk: float) -> void:
+	if g == &"dpad":
+		var cell := 24.0 * kk
+		_place(&"up", pos + Vector2(0, -cell), kk)
+		_place(&"down", pos + Vector2(0, cell), kk)
+		_place(&"left", pos + Vector2(-cell, 0), kk)
+		_place(&"right", pos + Vector2(cell, 0), kk)
+	else:
+		_place(g, pos, kk)
+
+
+func _place(id: StringName, pos: Vector2, k: float) -> void:
+	var b: TouchButton = _by_id[id]
+	b.position = pos
+	b.scale = Vector2(k, k)
+
+
+func _set_run_lock(on: bool) -> void:
+	if _run_lock == on:
+		return
+	_run_lock = on
+	var lock: TouchButton = _by_id[&"lock"]
+	if lock.latched != on:
+		lock.latched = on
+		lock.queue_redraw()
+	var b: TouchButton = _by_id[&"b"]
+	TouchButton._send(&"run_0", on or b._held)
+
+
+func _page_is_portrait() -> bool:
+	var v: Variant = JavaScriptBridge.eval("window.smbPortrait === true", true)
+	return v == true
+
+
+func _set_portrait(on: bool) -> void:
+	if on == _portrait:
+		return
+	_portrait = on
+	if on:
+		for b in _buttons:
+			b.release_all()
+		if not get_tree().paused:
+			get_tree().paused = true
+			_paused_by_portrait = true
+		if not AudioServer.is_bus_mute(0):
+			AudioServer.set_bus_mute(0, true)
+			_muted_by_portrait = true
+	else:
+		if _paused_by_portrait:
+			get_tree().paused = false
+			_paused_by_portrait = false
+		if _muted_by_portrait:
+			AudioServer.set_bus_mute(0, false)
+			_muted_by_portrait = false
+	_refresh()
+
+
+func _input(event: InputEvent) -> void:
+	if _editing:
+		_edit_input(event)
+		get_viewport().set_input_as_handled()
+		return
+	if event is InputEventScreenTouch or event is InputEventScreenDrag:
+		if not _touch_seen or _gamepad_in_use:
+			_touch_seen = true
+			_gamepad_in_use = false
+			_refresh()
+	elif _touch_seen and not always_show and not _touch_expected() and _is_pc_input(event):
+		_touch_seen = false
+		_refresh()
+	elif (event is InputEventJoypadButton and event.pressed) \
+			or (event is InputEventJoypadMotion and absf(event.axis_value) > 0.6):
+		if not _gamepad_in_use:
+			_gamepad_in_use = true
+			_refresh()
+
+
+func _on_joy_connection_changed(_device: int, connected: bool) -> void:
+	if not connected:
+		_gamepad_in_use = false
+	_refresh()
+
+
+func _is_pc_input(event: InputEvent) -> bool:
+	if event is InputEventKey:
+		return event.pressed
+	if event is InputEventMouseButton:
+		return event.pressed and event.device != InputEvent.DEVICE_ID_EMULATION
+	return false
+
+
+func _touch_expected() -> bool:
+	if OS.has_feature("web"):
+		return JavaScriptBridge.eval("window.smbTouchDevice === true", true) == true
+	return DisplayServer.is_touchscreen_available()
+
+
+func is_touch_device() -> bool:
+	if always_show:
+		return true
+	if not (OS.has_feature("web") or OS.has_feature("mobile")):
+		return false
+	return _touch_seen or _touch_expected()
+
+
+func _wants_controls() -> bool:
+	if _portrait:
+		return false
+	if always_show:
+		return true
+	if not (OS.has_feature("web") or OS.has_feature("mobile")):
+		return false
+	if not Input.get_connected_joypads().is_empty():
+		return false
+	if _gamepad_in_use:
+		return false
+	return is_touch_device()
+
+
+func _refresh() -> void:
+	if _editing:
+		return
+	var show_controls := _wants_controls()
+	if not show_controls:
+		for b in _buttons:
+			b.release_all()
+		_set_run_lock(false)
+	_root.visible = show_controls
+	visible = show_controls
+
+
+func _load_layout() -> void:
+	_cfg = {}
+	if not FileAccess.file_exists(LAYOUT_PATH):
+		return
+	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(LAYOUT_PATH))
+	if not parsed is Dictionary:
+		return
+	for g in GROUPS:
+		var c: Variant = (parsed as Dictionary).get(String(g))
+		if not c is Dictionary:
+			continue
+		var clean := {}
+		for key in ["x", "y", "s"]:
+			if (c as Dictionary).has(key) and ((c as Dictionary)[key] is float or (c as Dictionary)[key] is int):
+				clean[key] = float((c as Dictionary)[key])
+		if not clean.is_empty():
+			_cfg[String(g)] = clean
+
+
+func _save_layout() -> void:
+	var f := FileAccess.open(LAYOUT_PATH, FileAccess.WRITE)
+	if f == null:
+		return
+	f.store_string(JSON.stringify(_cfg))
+	f.close()
+
+
+func begin_layout_edit() -> void:
+	if _editing:
+		return
+	_editing = true
+	_edit_sel = &""
+	_drag_pointer = NO_POINTER
+	for b in _buttons:
+		b.release_all()
+	_set_run_lock(false)
+	_root.visible = false
+	visible = true
+	_edit_canvas.visible = true
+	_layout()
+	_edit_canvas.queue_redraw()
+
+
+func end_layout_edit() -> void:
+	if not _editing:
+		return
+	_editing = false
+	_drag_pointer = NO_POINTER
+	_edit_canvas.visible = false
+	_save_layout()
+	_layout()
+	_refresh()
+
+
+func _to_canvas(pos: Vector2) -> Vector2:
+	return _root.get_global_transform_with_canvas().affine_inverse() * pos
+
+
+func _edit_input(event: InputEvent) -> void:
+	if event is InputEventScreenTouch:
+		if event.pressed:
+			_edit_press(_to_canvas(event.position), event.index)
+		else:
+			_edit_release(event.index)
+	elif event is InputEventScreenDrag:
+		_edit_move(_to_canvas(event.position), event.index)
+	elif event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT \
+			and event.device != InputEvent.DEVICE_ID_EMULATION:
+		if event.pressed:
+			_edit_press(_to_canvas(event.position), MOUSE_POINTER)
+		else:
+			_edit_release(MOUSE_POINTER)
+	elif event is InputEventMouseMotion and event.device != InputEvent.DEVICE_ID_EMULATION:
+		_edit_move(_to_canvas(event.position), MOUSE_POINTER)
+
+
+func _current_group_pos(g: StringName) -> Vector2:
+	var vis := get_viewport().get_visible_rect()
+	var k := _control_scale(vis.size)
+	return _group_pos(g, vis.position, vis.size, k, _default_positions(vis.position, vis.size, k))
+
+
+func _group_at(p: Vector2) -> StringName:
+	var k := _control_scale(get_viewport().get_visible_rect().size)
+	var best: StringName = &""
+	var best_d := INF
+	for g in GROUPS:
+		var h: Vector2 = GROUP_HALF[g] * k * _group_scale(g)
+		var pos := _current_group_pos(g)
+		if absf(p.x - pos.x) <= h.x and absf(p.y - pos.y) <= h.y:
+			var d := p.distance_squared_to(pos)
+			if d < best_d:
+				best_d = d
+				best = g
+	return best
+
+
+func _edit_press(p: Vector2, pointer: int) -> void:
+	for id in _tool_rects:
+		if (_tool_rects[id] as Rect2).has_point(p):
+			_tool_pressed(id)
+			return
+	if _drag_pointer != NO_POINTER:
+		return
+	var hit := _group_at(p)
+	_edit_sel = hit
+	if hit != &"":
+		_drag_pointer = pointer
+		_drag_grab = _current_group_pos(hit) - p
+	_edit_canvas.queue_redraw()
+
+
+func _edit_move(p: Vector2, pointer: int) -> void:
+	if pointer != _drag_pointer or _edit_sel == &"":
+		return
+	var vis := get_viewport().get_visible_rect()
+	var k := _control_scale(vis.size)
+	var pos := _clamp_group(_edit_sel, p + _drag_grab, vis.position, vis.size, k * _group_scale(_edit_sel))
+	var c: Dictionary = _cfg.get(String(_edit_sel), {})
+	c["x"] = (pos.x - vis.position.x) / vis.size.x
+	c["y"] = (pos.y - vis.position.y) / vis.size.y
+	c["s"] = _group_scale(_edit_sel)
+	_cfg[String(_edit_sel)] = c
+	_layout()
+
+
+func _edit_release(pointer: int) -> void:
+	if pointer == _drag_pointer:
+		_drag_pointer = NO_POINTER
+		_save_layout()
+
+
+func _tool_pressed(id: StringName) -> void:
+	match id:
+		&"minus":
+			_bump_scale(-SCALE_STEP)
+		&"plus":
+			_bump_scale(SCALE_STEP)
+		&"reset":
+			_cfg.clear()
+			_edit_sel = &""
+			_save_layout()
+			_layout()
+		&"done":
+			end_layout_edit()
+
+
+func _bump_scale(delta: float) -> void:
+	var targets: Array[StringName] = []
+	if _edit_sel != &"":
+		targets.append(_edit_sel)
+	else:
+		targets.assign(GROUPS)
+	for g in targets:
+		var c: Dictionary = _cfg.get(String(g), {})
+		c["s"] = snappedf(clampf(_group_scale(g) + delta, SCALE_MIN, SCALE_MAX), 0.05)
+		_cfg[String(g)] = c
+	_layout()
+	_save_layout()
+
+
+func _draw_text(ci: CanvasItem, text: String, center: Vector2, font_size: int, color: Color) -> void:
+	var font := ThemeDB.fallback_font
+	var size := font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, font_size)
+	ci.draw_string(font, Vector2(center.x - size.x * 0.5, center.y + size.y * 0.3), text,
+			HORIZONTAL_ALIGNMENT_LEFT, -1, font_size, color)
+
+
+func _draw_editor(ci: CanvasItem) -> void:
+	var vis := get_viewport().get_visible_rect()
+	var o := vis.position
+	var s := vis.size
+	var k := _control_scale(s)
+	var defaults := _default_positions(o, s, k)
+	var ek := maxf(0.5, minf(k, s.x * 0.95 / TOOLBAR_WIDTH))
+	var text_size := maxi(6, roundi(8.0 * ek))
+	var white := Color(1, 1, 1, 0.9)
+	var gold := Color(1.0, 0.85, 0.2, 1.0)
+
+	ci.draw_rect(vis, Color(0, 0, 0, 0.78))
+
+	_tool_rects.clear()
+	var bar_w := TOOLBAR_WIDTH * ek
+	var x := o.x + (s.x - bar_w) * 0.5
+	var y := o.y + 6.0 * ek
+	for t in TOOLS:
+		var w: float = t[2] * ek
+		var rect := Rect2(x, y, w, TOOL_HEIGHT * ek)
+		_tool_rects[t[0]] = rect
+		ci.draw_rect(rect, Color(1, 1, 1, 0.22))
+		ci.draw_rect(rect, Color(1, 1, 1, 0.7), false, maxf(1.0, ek))
+		_draw_text(ci, t[1], rect.get_center(), text_size, white)
+		x += w + TOOL_GAP * ek
+
+	var status := "ALL BUTTONS"
+	if _edit_sel != &"":
+		status = "%s  %d%%" % [GROUP_NAMES[_edit_sel], roundi(_group_scale(_edit_sel) * 100.0)]
+	_draw_text(ci, status, Vector2(o.x + s.x * 0.5, y + (TOOL_HEIGHT + 10.0) * ek), text_size, gold)
+	var hint_y := o.y + s.y * 0.42
+	var hint_line := 11.0 * ek
+	var hints := ["DRAG A BUTTON TO MOVE IT", "TAP ONE, THEN + OR - TO RESIZE IT",
+			"TAP EMPTY SPACE TO RESIZE ALL"]
+	for i in hints.size():
+		_draw_text(ci, hints[i], Vector2(o.x + s.x * 0.5, hint_y + i * hint_line), text_size,
+				Color(1, 1, 1, 0.55))
+
+	for g in GROUPS:
+		var kk := k * _group_scale(g)
+		var pos := _group_pos(g, o, s, k, defaults)
+		var picked := g == _edit_sel
+		var fill := Color(1.0, 0.85, 0.2, 0.45) if picked else Color(1, 1, 1, 0.22)
+		var edge := gold if picked else Color(1, 1, 1, 0.7)
+		var line := maxf(1.0, kk)
+		for part in GROUP_PARTS[g]:
+			var center: Vector2 = pos + (part[0] as Vector2) * kk
+			var size: Vector2 = (part[1] as Vector2) * kk
+			if part[2]:
+				ci.draw_circle(center, size.x * 0.5, fill)
+				ci.draw_arc(center, size.x * 0.5, 0.0, TAU, 32, edge, line)
+			else:
+				ci.draw_rect(Rect2(center - size * 0.5, size), fill)
+				ci.draw_rect(Rect2(center - size * 0.5, size), edge, false, line)
+			var arrow: Vector2 = part[4]
+			if arrow != Vector2.ZERO:
+				var side := arrow.orthogonal()
+				ci.draw_colored_polygon(PackedVector2Array([
+					center + arrow * 6.0 * kk,
+					center - arrow * 4.0 * kk + side * 6.0 * kk,
+					center - arrow * 4.0 * kk - side * 6.0 * kk]), edge)
+			elif part[3] != "":
+				_draw_text(ci, part[3], center, maxi(6, roundi(8.0 * kk)), white)
+		if picked:
+			var h: Vector2 = (GROUP_HALF[g] as Vector2) * kk
+			ci.draw_rect(Rect2(pos - h, h * 2.0), Color(gold, 0.6), false, 1.0)
diff --git a/Scripts/UI/TouchLayoutRow.gd b/Scripts/UI/TouchLayoutRow.gd
