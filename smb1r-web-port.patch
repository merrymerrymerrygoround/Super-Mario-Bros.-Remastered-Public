+const BASE_HEIGHT := 240.0
+const BASE_BUTTON := 32.0
+const TARGET_BUTTON_CSS_PX := 56.0
+const MAX_BOOST := 1.75
+const CLUSTER_WIDTH_UNITS := 154.0
+const MAX_WIDTH_SHARE := 0.9
+
+const LAYOUT_PATH := "user://touch_layout.json"
+const SCALE_MIN := 0.5
+const SCALE_MAX := 2.0
+const SCALE_STEP := 0.1
+const NO_POINTER := -999
+const MOUSE_POINTER := -2
+const GROUPS: Array[StringName] = [&"dpad", &"a", &"b", &"lock", &"select", &"start"]
+const GROUP_HALF := {
+	&"dpad": Vector2(36, 36), &"a": Vector2(16, 16), &"b": Vector2(16, 16),
+	&"lock": Vector2(13, 13), &"select": Vector2(16, 7), &"start": Vector2(16, 7),
+}
+const GROUP_NAMES := {
+	&"dpad": "D-PAD", &"a": "A BUTTON", &"b": "B BUTTON",
+	&"lock": "LOCK", &"select": "SELECT", &"start": "START",
+}
+const GROUP_PARTS := {
+	&"dpad": [
+		[Vector2(0, -24), Vector2(24, 24), false, "", Vector2.UP],
+		[Vector2(0, 24), Vector2(24, 24), false, "", Vector2.DOWN],
+		[Vector2(-24, 0), Vector2(24, 24), false, "", Vector2.LEFT],
+		[Vector2(24, 0), Vector2(24, 24), false, "", Vector2.RIGHT],
+	],
+	&"a": [[Vector2.ZERO, Vector2(32, 32), true, "A", Vector2.ZERO]],
+	&"b": [[Vector2.ZERO, Vector2(32, 32), true, "B", Vector2.ZERO]],
+	&"lock": [[Vector2.ZERO, Vector2(26, 26), true, "LOCK", Vector2.ZERO]],
+	&"select": [[Vector2.ZERO, Vector2(32, 14), false, "SEL", Vector2.ZERO]],
+	&"start": [[Vector2.ZERO, Vector2(32, 14), false, "START", Vector2.ZERO]],
+}
+const TOOLS := [
+	[&"minus", "-", 20.0], [&"plus", "+", 20.0], [&"reset", "RESET", 44.0], [&"done", "DONE", 40.0],
+]
+const TOOL_HEIGHT := 16.0
+const TOOL_GAP := 4.0
+const TOOLBAR_WIDTH := 136.0
+
+var _root: Node2D
