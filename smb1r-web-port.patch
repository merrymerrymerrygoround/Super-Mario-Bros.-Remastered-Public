diff --git a/Scripts/UI/TouchControls.gd b/Scripts/UI/TouchControls.gd
new file mode 100644
index 0000000..716031e
--- /dev/null
+++ b/Scripts/UI/TouchControls.gd
@@ -0,0 +1,339 @@
+extends CanvasLayer
+## On-screen NES-style controls (D-pad, A, B, Select, Start, Run lock) for touch devices.
+##
+## Autoloaded. Shown automatically on touch-capable Web / mobile builds, hidden
+## while a gamepad is connected or in use. Buttons are TouchScreenButtons whose
+## primary `action` is set natively; extra actions (e.g. ui_accept) are sent as
+## InputEventActions so menus and gameplay both work like the keyboard does.
+##
+## Layout: positions are recomputed from the *visible* viewport rect every time
+## it changes (window resize, rotation, Size setting, per-level resolution
+## enforcement), so the controls stay anchored to the real screen edges and keep
+## a thumb-friendly size at any aspect ratio.
+##
+## Portrait: the page (see export_presets.cfg head_include) shows a "rotate your
+## device" overlay and sets window.smbPortrait. While it is set the game is
+## paused and muted, and the controls are released.
+
+## Debug: force the controls on (e.g. desktop testing).
+@export var always_show := false
+
+const LAYER := 100
+const PORTRAIT_POLL_SECONDS := 0.2
+## Layout constants below were designed for a 256x240 viewport (1 unit = 1 px there).
+const BASE_HEIGHT := 240.0
+const BASE_BUTTON := 32.0
+## Smallest comfortable thumb target, in CSS pixels, for a BASE_BUTTON-sized button.
+const TARGET_BUTTON_CSS_PX := 56.0
+const MAX_BOOST := 1.75
+## dpad (cell edge to 2 cells out) + right cluster must fit within this share of the width.
+const CLUSTER_WIDTH_UNITS := 154.0
+const MAX_WIDTH_SHARE := 0.9
+
+var _root: Node2D
+var _buttons: Array[TouchButton] = []
+var _by_id: Dictionary = {}
+var _touch_seen := false
+var _gamepad_in_use := false
+var _layout_key := Vector4.ZERO
+var _run_lock := false
+var _portrait := false
+var _portrait_timer := 0.0
+var _paused_by_portrait := false
+var _muted_by_portrait := false
+
+
+class TouchButton extends TouchScreenButton:
+	signal toggled(on: bool)
+
+	const COLOR_FILL := Color(1, 1, 1, 0.20)
+	const COLOR_FILL_HELD := Color(1, 1, 1, 0.45)
+	const COLOR_FILL_LATCHED := Color(1.0, 0.85, 0.2, 0.55)
+	const COLOR_EDGE := Color(1, 1, 1, 0.65)
+
+	var label := ""
+	var arrow := Vector2.ZERO
+	var round_shape := false
+	var button_size := Vector2.ZERO
+	var extra_actions: Array[StringName] = []
+	## Press-and-latch button (used by the run lock). Has no native action.
+	var toggle := false
+	var latched := false
+	## Extra actions in `keep_actions` are not released while keep_pressed returns true.
+	var keep_actions: Array[StringName] = []
+	var keep_pressed := Callable()
+	var _held := false
+
+	func _ready() -> void:
+		pressed.connect(_on_pressed)
+		released.connect(_on_released)
+
+	func _on_pressed() -> void:
+		_held = true
+		for a in extra_actions:
+			_send(a, true)
+		if toggle:
+			latched = not latched
+			toggled.emit(latched)
+		queue_redraw()
+
+	func _on_released() -> void:
+		_held = false
+		for a in extra_actions:
+			if a in keep_actions and keep_pressed.is_valid() and keep_pressed.call():
+				continue
+			_send(a, false)
+		queue_redraw()
+
+	func release_all() -> void:
+		if _held:
+			_on_released()
+
+	static func _send(action: StringName, down: bool) -> void:
+		var ev := InputEventAction.new()
+		ev.action = action
+		ev.pressed = down
+		ev.strength = 1.0 if down else 0.0
+		Input.parse_input_event(ev)
+
+	func _draw() -> void:
+		var fill := COLOR_FILL_HELD if _held else COLOR_FILL
+		if toggle and latched:
+			fill = COLOR_FILL_LATCHED
+		if round_shape:
+			var r := button_size.x * 0.5
+			draw_circle(Vector2.ZERO, r, fill)
+			draw_arc(Vector2.ZERO, r, 0.0, TAU, 28, COLOR_EDGE, 1.0)
+		else:
+			var rect := Rect2(-button_size * 0.5, button_size)
+			draw_rect(rect, fill)
+			draw_rect(rect, COLOR_EDGE, false, 1.0)
+		if arrow != Vector2.ZERO:
+			var side := arrow.orthogonal()
+			draw_colored_polygon(PackedVector2Array([
+				arrow * 6.0, -arrow * 4.0 + side * 6.0, -arrow * 4.0 - side * 6.0
+			]), COLOR_EDGE)
+		elif label != "":
+			var font := ThemeDB.fallback_font
+			var size := font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, 8)
+			draw_string(font, Vector2(-size.x * 0.5, size.y * 0.3), label,
+					HORIZONTAL_ALIGNMENT_LEFT, -1, 8, Color(1, 1, 1, 0.9))
+
+
+func _ready() -> void:
+	print("[smb1r] TouchControls ready")
+	layer = LAYER
+	process_mode = Node.PROCESS_MODE_ALWAYS # keep working while the game is paused
+	_root = Node2D.new()
+	add_child(_root)
+	_build_buttons()
+	_layout()
+	Input.joy_connection_changed.connect(_on_joy_connection_changed)
+	_refresh()
+
+
+func _process(delta: float) -> void:
+	_check_layout()
+	if OS.has_feature("web"):
+		_portrait_timer -= delta
+		if _portrait_timer <= 0.0:
+			_portrait_timer = PORTRAIT_POLL_SECONDS
+			_set_portrait(_page_is_portrait())
+
+
+func _build_buttons() -> void:
+	# Shapes are in base units (designed for 256x240); _layout() positions and
+	# scales the nodes, which scales their hit shapes with them.
+	_add(&"up", Vector2(24, 24), "", &"move_up_0", [&"ui_up"], true, Vector2.UP)
+	_add(&"down", Vector2(24, 24), "", &"move_down_0", [&"ui_down"], true, Vector2.DOWN)
+	_add(&"left", Vector2(24, 24), "", &"move_left_0", [&"ui_left"], true, Vector2.LEFT)
+	_add(&"right", Vector2(24, 24), "", &"move_right_0", [&"ui_right"], true, Vector2.RIGHT)
+	# B = run / fire, A = jump (same pairs the keyboard binds to X and Z). B's native
+	# action is fire; run is sent as an extra so the run lock can keep it held.
+	_add(&"b", Vector2(32, 32), "B", &"action_0", [&"run_0", &"ui_back"], false, Vector2.ZERO, true)
+	_add(&"a", Vector2(32, 32), "A", &"jump_0", [&"ui_accept"], false, Vector2.ZERO, true)
+	# Run lock ("shift lock"): tap to hold run on, tap again to release.
+	_add(&"lock", Vector2(26, 26), "LOCK", &"", [], false, Vector2.ZERO, true)
+	# Select = reserve item drop, Start = pause.
+	_add(&"select", Vector2(32, 14), "SEL", &"drop_item", [&"ui_select"])
+	_add(&"start", Vector2(32, 14), "START", &"pause", [])
+
+	var b: TouchButton = _by_id[&"b"]
+	b.keep_actions = [&"run_0"]
+	b.keep_pressed = func() -> bool: return _run_lock
+	var lock: TouchButton = _by_id[&"lock"]
+	lock.toggle = true
+	lock.toggled.connect(_set_run_lock)
+
+
+func _add(id: StringName, size: Vector2, label: String, action: StringName,
+		extras: Array[StringName], passby := false, arrow := Vector2.ZERO, round_shape := false) -> void:
+	var b := TouchButton.new()
+	b.action = String(action)
+	b.passby_press = passby # lets the thumb slide between D-pad directions
+	b.visibility_mode = TouchScreenButton.VISIBILITY_ALWAYS
+	b.shape_visible = false
+	b.label = label
+	b.arrow = arrow
+	b.round_shape = round_shape
+	b.button_size = size
+	b.extra_actions = extras
+	if round_shape:
+		var circle := CircleShape2D.new()
+		circle.radius = size.x * 0.5
+		b.shape = circle
+	else:
+		var rect := RectangleShape2D.new()
+		rect.size = size
+		b.shape = rect
+	_root.add_child(b)
+	_buttons.append(b)
+	_by_id[id] = b
+
+
+# --- Layout ------------------------------------------------------------------
+
+func _layout_signature() -> Vector4:
+	var vis := get_viewport().get_visible_rect().size
+	var win := Vector2(DisplayServer.window_get_size())
+	return Vector4(vis.x, vis.y, win.x, win.y)
+
+
+func _check_layout() -> void:
+	var key := _layout_signature()
+	if key != _layout_key:
+		_layout()
+
+
+## Scale factor applied to the base (256x240) layout.
+func _control_scale(vis_size: Vector2) -> float:
+	var u := vis_size.y / BASE_HEIGHT # keep proportions if the logical height isn't 240
+	var win := Vector2(DisplayServer.window_get_size())
+	var boost := 1.0
+	if win.x > 0.0 and win.y > 0.0 and vis_size.x > 0.0 and vis_size.y > 0.0:
+		# Physical pixels per viewport unit (letterboxed, so the smaller axis wins).
+		var px_per_unit := minf(win.x / vis_size.x, win.y / vis_size.y)
+		var dpr := maxf(1.0, DisplayServer.screen_get_scale())
+		var css_per_unit := px_per_unit / dpr
+		if css_per_unit > 0.0:
+			boost = clampf(TARGET_BUTTON_CSS_PX / (BASE_BUTTON * u * css_per_unit), 1.0, MAX_BOOST)
+	var k := u * boost
+	# Never let the two clusters collide on narrow views.
+	return minf(k, MAX_WIDTH_SHARE * vis_size.x / CLUSTER_WIDTH_UNITS)
+
+
+func _layout() -> void:
+	_layout_key = _layout_signature()
+	var vis := get_viewport().get_visible_rect()
+	var o := vis.position
+	var s := vis.size
+	var k := _control_scale(s)
+
+	var dpad := o + Vector2(40.0, 0.0) * k + Vector2(0.0, s.y - 48.0 * k)
+	var cell := 24.0 * k
+	_place(&"up", dpad + Vector2(0, -cell), k)
+	_place(&"down", dpad + Vector2(0, cell), k)
+	_place(&"left", dpad + Vector2(-cell, 0), k)
+	_place(&"right", dpad + Vector2(cell, 0), k)
+
+	_place(&"a", o + Vector2(s.x - 28.0 * k, s.y - 46.0 * k), k)
+	_place(&"b", o + Vector2(s.x - 62.0 * k, s.y - 32.0 * k), k)
+	_place(&"lock", o + Vector2(s.x - 62.0 * k, s.y - 68.0 * k), k)
+
+	_place(&"select", o + Vector2(s.x * 0.5 - 18.0 * k, s.y - 14.0 * k), k)
+	_place(&"start", o + Vector2(s.x * 0.5 + 18.0 * k, s.y - 14.0 * k), k)
+
+
+func _place(id: StringName, pos: Vector2, k: float) -> void:
+	var b: TouchButton = _by_id[id]
+	b.position = pos
+	b.scale = Vector2(k, k)
+
+
+# --- Run lock ----------------------------------------------------------------
+
+func _set_run_lock(on: bool) -> void:
+	if _run_lock == on:
+		return
+	_run_lock = on
+	var lock: TouchButton = _by_id[&"lock"]
+	if lock.latched != on:
+		lock.latched = on
+		lock.queue_redraw()
+	var b: TouchButton = _by_id[&"b"]
+	TouchButton._send(&"run_0", on or b._held)
+
+
+# --- Portrait ----------------------------------------------------------------
+
+func _page_is_portrait() -> bool:
+	var v: Variant = JavaScriptBridge.eval("window.smbPortrait === true", true)
+	return v == true
+
+
+func _set_portrait(on: bool) -> void:
+	if on == _portrait:
+		return
+	_portrait = on
+	if on:
+		for b in _buttons:
+			b.release_all()
+		if not get_tree().paused:
+			get_tree().paused = true
+			_paused_by_portrait = true
+		if not AudioServer.is_bus_mute(0):
+			AudioServer.set_bus_mute(0, true)
+			_muted_by_portrait = true
+	else:
+		if _paused_by_portrait:
+			get_tree().paused = false
+			_paused_by_portrait = false
+		if _muted_by_portrait:
+			AudioServer.set_bus_mute(0, false)
+			_muted_by_portrait = false
+	_refresh()
+
+
+# --- Visibility --------------------------------------------------------------
+
+func _input(event: InputEvent) -> void:
+	if event is InputEventScreenTouch or event is InputEventScreenDrag:
+		if not _touch_seen or _gamepad_in_use:
+			_touch_seen = true
+			_gamepad_in_use = false
+			_refresh()
+	elif (event is InputEventJoypadButton and event.pressed) \
+			or (event is InputEventJoypadMotion and absf(event.axis_value) > 0.6):
+		if not _gamepad_in_use:
+			_gamepad_in_use = true
+			_refresh()
+
+
+func _on_joy_connection_changed(_device: int, connected: bool) -> void:
+	if not connected:
+		_gamepad_in_use = false
+	_refresh()
+
+
+func _wants_controls() -> bool:
+	if _portrait:
+		return false
+	if always_show:
+		return true
+	if not (OS.has_feature("web") or OS.has_feature("mobile")):
+		return false
+	if not Input.get_connected_joypads().is_empty():
+		return false # Bluetooth / USB controller present
+	if _gamepad_in_use:
+		return false
+	return _touch_seen or DisplayServer.is_touchscreen_available()
+
+
+func _refresh() -> void:
+	var show_controls := _wants_controls()
+	if not show_controls:
+		for b in _buttons:
+			b.release_all()
+		_set_run_lock(false)
+	_root.visible = show_controls
+	visible = show_controls
diff --git a/Scripts/UI/WebImporter.gd b/Scripts/UI/WebImporter.gd
new file mode 100644
index 0000000..b1d8801
--- /dev/null
+++ b/Scripts/UI/WebImporter.gd
@@ -0,0 +1,221 @@
+class_name WebImporter
+extends Node
+## Imports resource packs and mods (.zip) from the browser (Web export only).
+##
+## The page (export_presets.cfg head_include) provides window.smbImporter: a modal
+## overlay whose "choose file" control is a real <input type="file"> the player
+## taps directly. That is what makes it work on iOS Safari, which only opens file
+## pickers from a genuine tap on the input, not from a Godot Button press.
+##
+## The chosen file stays in the page. We pull it across in base64 chunks (so big
+## zips never need one giant string), write it to a temp file in user://, then:
+##   pack: unzip into user://resource_packs/<name>/ (usable immediately)
+##   mod:  keep the zip in user://mods/ and reload the page (mods load at startup)
+
+signal pack_imported(pack_id: String)
+
+const MAX_BYTES := 96 * 1024 * 1024
+## Must match CH in the page script, and be a multiple of 3 so each chunk is clean base64.
+const CHUNK_BYTES := 393216
+const TMP_PATH := "user://import_tmp.zip"
+const MODS_DIR := "user://mods"
+
+var _callback: JavaScriptObject = null
+var _kind := ""
+var _busy := false
+
+
+## kind: "pack" or "mod"
+func start(kind: String) -> void:
+	if not OS.has_feature("web") or _busy:
+		return
+	_kind = kind
+	_callback = JavaScriptBridge.create_callback(_on_js_event)
+	JavaScriptBridge.get_interface("window").smbImportCallback = _callback
+	var title := "IMPORT RESOURCE PACK" if kind == "pack" else "IMPORT MOD"
+	var hint := "PICK A RESOURCE PACK .ZIP (WITH A pack_info.json)." if kind == "pack" \
+			else "PICK A MOD .ZIP. THE GAME RELOADS TO APPLY IT."
+	JavaScriptBridge.eval("window.smbImporter.prompt(%s, %s, %s, %d);" % [
+		JSON.stringify(kind), JSON.stringify(title), JSON.stringify(hint), MAX_BYTES], true)
+
+
+## Deletes every imported mod and reloads the page (recovery if a mod misbehaves).
+func remove_all_mods() -> void:
+	if not OS.has_feature("web"):
+		return
+	var removed := 0
+	for f in DirAccess.get_files_at(MODS_DIR):
+		if f.to_lower().ends_with(".zip"):
+			DirAccess.remove_absolute(MODS_DIR.path_join(f))
+			removed += 1
+	_callback = JavaScriptBridge.create_callback(_on_js_event)
+	JavaScriptBridge.get_interface("window").smbImportCallback = _callback
+	var msg := "REMOVED %d MOD%s. RELOADING..." % [removed, "" if removed == 1 else "S"]
+	_finish(true, msg, 1500)
+
+
+func _on_js_event(args: Array) -> void:
+	var evt := str(args[0]) if args.size() > 0 else ""
+	match evt:
+		"file":
+			_receive.call_deferred(str(args[2]), int(args[3]))
+		"cancel":
+			_busy = false
+		"error":
+			_busy = false
+			_play("bump")
+
+
+func _receive(file_name: String, size: int) -> void:
+	_busy = true
+	_status("READING FILE...")
+	var out := FileAccess.open(TMP_PATH, FileAccess.WRITE)
+	if out == null:
+		_finish(false, "COULD NOT WRITE TO BROWSER STORAGE.")
+		return
+	var chunks := ceili(float(size) / CHUNK_BYTES)
+	for i in chunks:
+		var b64: Variant = JavaScriptBridge.eval("window.smbImporter.chunk(%d)" % i, true)
+		if typeof(b64) != TYPE_STRING:
+			out.close()
+			_cleanup()
+			_finish(false, "COULD NOT READ THE FILE. TRY AGAIN.")
+			return
+		out.store_buffer(Marshalls.base64_to_raw(b64))
+		if i % 8 == 7:
+			_status("COPYING... %d%%" % int(100.0 * (i + 1) / chunks))
+			await get_tree().process_frame
+	out.close()
+	JavaScriptBridge.eval("window.smbImporter.release();", true)
+	_status("INSTALLING...")
+	await get_tree().process_frame
+
+	var result: Dictionary
+	if _kind == "mod":
+		result = install_mod(TMP_PATH, file_name)
+	else:
+		result = install_resource_pack(TMP_PATH, file_name)
+	_cleanup()
+
+	var ok: bool = result.get("ok", false)
+	var reload_ms := 0
+	if ok and _kind == "mod":
+		# Give the browser time to persist user:// to IndexedDB before reloading.
+		reload_ms = 1500 + int(size / 1048576.0 * 60.0)
+	_finish(ok, str(result.get("message", "")), reload_ms)
+	if ok and _kind == "pack":
+		pack_imported.emit(str(result.get("pack_id", "")))
+
+
+func _status(text: String) -> void:
+	JavaScriptBridge.eval("window.smbImporter.status(%s);" % JSON.stringify(text), true)
+
+
+func _finish(ok: bool, message: String, reload_ms := 0) -> void:
+	_busy = false
+	_play("coin" if ok else "bump")
+	JavaScriptBridge.eval("window.smbImporter.finish(%s, %s, %d);" % [
+		JSON.stringify(message), "true" if ok else "false", reload_ms], true)
+
+
+func _play(sfx: String) -> void:
+	AudioManager.play_global_sfx(sfx)
+
+
+func _cleanup() -> void:
+	if FileAccess.file_exists(TMP_PATH):
+		DirAccess.remove_absolute(TMP_PATH)
+
+
+static func _err(message: String) -> Dictionary:
+	return {"ok": false, "message": message}
+
+
+## Keeps letters, digits, space, dot, dash and underscore.
+static func _sanitize(text: String) -> String:
+	var out := ""
+	for ch in text:
+		var code := ch.unicode_at(0)
+		var keep := (code >= 48 and code <= 57) or (code >= 65 and code <= 90) \
+				or (code >= 97 and code <= 122) or ch in [" ", ".", "-", "_"]
+		out += ch if keep else "_"
+	return out.strip_edges().lstrip(".")
+
+
+static func install_resource_pack(zip_path: String, file_name: String) -> Dictionary:
+	var zip := ZIPReader.new()
+	if zip.open(zip_path) != OK:
+		return _err("NOT A VALID ZIP FILE.")
+	var files := zip.get_files()
+
+	# Find the shallowest pack_info.json: the pack is either at the zip root or
+	# inside one folder (the usual result of zipping a folder).
+	var info_path := ""
+	for f in files:
+		if f.begins_with("__MACOSX/") or f.get_file() != "pack_info.json":
+			continue
+		if info_path == "" or f.count("/") < info_path.count("/"):
+			info_path = f
+	if info_path == "":
+		zip.close()
+		return _err("NOT A RESOURCE PACK: NO pack_info.json FOUND.")
+
+	var prefix := info_path.get_base_dir() # "" when at the root
+	var pack_id := _sanitize(prefix.get_file() if prefix != "" else file_name.get_basename())
+	if pack_id == "" or pack_id == Global.ROM_PACK_NAME:
+		pack_id = "imported_pack"
+	var dest_root := Global.config_path.path_join("resource_packs").path_join(pack_id)
+	if DirAccess.dir_exists_absolute(dest_root):
+		Global.trash_or_delete(dest_root) # re-importing replaces the old copy
+
+	var written := 0
+	for f in files:
+		if f.ends_with("/") or f.begins_with("__MACOSX/") or f.get_file() == ".DS_Store":
+			continue
+		var rel := f
+		if prefix != "":
+			if not f.begins_with(prefix + "/"):
+				continue
+			rel = f.substr(prefix.length() + 1)
+		if rel == "" or rel.begins_with("/") or ".." in rel.split("/"):
+			continue # never write outside the pack folder
+		var dest := dest_root.path_join(rel)
+		DirAccess.make_dir_recursive_absolute(dest.get_base_dir())
+		var out := FileAccess.open(dest, FileAccess.WRITE)
+		if out == null:
+			zip.close()
+			return _err("COULD NOT WRITE " + rel.get_file().to_upper() + ".")
+		out.store_buffer(zip.read_file(f))
+		out.close()
+		written += 1
+	zip.close()
+
+	if written == 0:
+		return _err("THE PACK WAS EMPTY.")
+	return {"ok": true, "pack_id": pack_id,
+			"message": "ADDED PACK \"%s\" (%d FILES). SELECT IT IN THE LIST." % [pack_id.to_upper(), written]}
+
+
+static func install_mod(zip_path: String, file_name: String) -> Dictionary:
+	var zip := ZIPReader.new()
+	if zip.open(zip_path) != OK:
+		return _err("NOT A VALID ZIP FILE.")
+	var has_manifest := false
+	for f in zip.get_files():
+		if f.begins_with("mods-unpacked/") and f.get_file() == "manifest.json":
+			has_manifest = true
+			break
+	zip.close()
+	if not has_manifest:
+		return _err("NOT A MOD: NO mods-unpacked MANIFEST FOUND.")
+
+	var zip_name := _sanitize(file_name.get_file())
+	if not zip_name.to_lower().ends_with(".zip"):
+		zip_name += ".zip"
+	DirAccess.make_dir_recursive_absolute(MODS_DIR)
+	var dest := MODS_DIR.path_join(zip_name)
+	if FileAccess.file_exists(dest):
+		DirAccess.remove_absolute(dest)
+	if DirAccess.copy_absolute(zip_path, dest) != OK:
+		return _err("COULD NOT SAVE THE MOD.")
+	return {"ok": true, "message": "ADDED MOD \"%s\". RELOADING..." % zip_name.get_basename().to_upper()}
diff --git a/Scripts/UI/WebRomPicker.gd b/Scripts/UI/WebRomPicker.gd
new file mode 100644
index 0000000..3eee48f
--- /dev/null
+++ b/Scripts/UI/WebRomPicker.gd
@@ -0,0 +1,107 @@
+class_name WebRomPicker
+extends RefCounted
+## Browser ROM picker for the Web export (iOS Safari friendly).
+##
+## iOS Safari only opens a file picker if input.click() runs inside the user's
+## tap handler. Godot's Button.pressed fires later (next engine frame), which
+## Safari rejects, so the hidden <input type="file"> is opened from a DOM-level
+## touchend/pointerup/click listener while the picker is "armed". The chosen
+## file is read in JS and handed to Godot as base64 through a JS callback.
+
+signal rom_loaded(file_name: String, data: PackedByteArray)
+signal rom_rejected(reason: String) ## "too_large" or "read_error"
+signal picker_cancelled
+
+const MAX_ROM_BYTES := 2 * 1024 * 1024
+
+const JS_SETUP := """
+(function () {
+	if (window.smbRomPicker) { return; }
+	var MAX = %d;
+	var input = document.createElement('input');
+	input.type = 'file';
+	input.accept = '.nes,application/octet-stream';
+	input.setAttribute('aria-hidden', 'true');
+	input.style.cssText = 'position:fixed;left:0;top:0;width:1px;height:1px;opacity:0;pointer-events:none;';
+	document.body.appendChild(input);
+
+	var picker = { armed: false, lastOpen: 0 };
+
+	function notify(kind, a, b) {
+		var cb = window.smbRomPickerCallback;
+		if (typeof cb === 'function') { cb(kind, a || '', b || ''); }
+	}
+
+	picker.open = function () {
+		var now = Date.now();
+		if (now - picker.lastOpen < 800) { return; }
+		picker.lastOpen = now;
+		input.click();
+	};
+	picker.arm = function () { picker.armed = true; };
+	picker.disarm = function () { picker.armed = false; };
+
+	input.addEventListener('change', function () {
+		var file = input.files && input.files[0];
+		if (!file) { notify('cancel'); return; }
+		if (file.size > MAX) { input.value = ''; notify('too_large', file.name); return; }
+		var reader = new FileReader();
+		reader.onerror = function () { notify('read_error', file.name); };
+		reader.onload = function () {
+			var bytes = new Uint8Array(reader.result);
+			var bin = '';
+			for (var i = 0; i < bytes.length; i += 0x8000) {
+				bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
+			}
+			input.value = '';
+			notify('file', file.name, btoa(bin));
+		};
+		reader.readAsArrayBuffer(file);
+	});
+	input.addEventListener('cancel', function () { notify('cancel'); });
+
+	['touchend', 'pointerup', 'click'].forEach(function (type) {
+		window.addEventListener(type, function () {
+			if (picker.armed) { picker.open(); }
+		}, true);
+	});
+	window.smbRomPicker = picker;
+})();
+""" % MAX_ROM_BYTES
+
+var _js_callback: JavaScriptObject = null
+
+
+func start() -> bool:
+	if not OS.has_feature("web"):
+		return false
+	JavaScriptBridge.eval(JS_SETUP, true)
+	_js_callback = JavaScriptBridge.create_callback(_on_js_event)
+	JavaScriptBridge.get_interface("window").smbRomPickerCallback = _js_callback
+	JavaScriptBridge.eval("window.smbRomPicker.arm();", true)
+	return true
+
+
+func stop() -> void:
+	if _js_callback == null:
+		return
+	JavaScriptBridge.eval("if (window.smbRomPicker) { window.smbRomPicker.disarm(); } window.smbRomPickerCallback = null;", true)
+	_js_callback = null
+
+
+## Fallback for browsers that allow opening the picker outside a DOM gesture
+## (desktop). On iOS the armed DOM listener does the real work.
+func open_now() -> void:
+	if OS.has_feature("web"):
+		JavaScriptBridge.eval("if (window.smbRomPicker) { window.smbRomPicker.open(); }", true)
+
+
+func _on_js_event(args: Array) -> void:
+	var kind := str(args[0]) if args.size() > 0 else ""
+	match kind:
+		"file":
+			rom_loaded.emit(str(args[1]), Marshalls.base64_to_raw(str(args[2])))
+		"too_large", "read_error":
+			rom_rejected.emit(kind)
+		"cancel":
+			picker_cancelled.emit()
diff --git a/WEB_BUILD.md b/WEB_BUILD.md
