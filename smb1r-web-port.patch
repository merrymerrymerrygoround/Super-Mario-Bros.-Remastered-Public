+</style>
+<script>
+(function () {
+  var lines = [], panel = null, open = false;
+  var NL = String.fromCharCode(10);
+  function ensure() {
+    if (panel || !document.body) { return; }
+    panel = document.createElement('pre');
+    panel.style.cssText = 'position:fixed;left:0;right:0;top:0;max-height:60%;overflow:auto;margin:0;padding:6px;background:rgba(0,0,0,0.85);color:#9f9;font:10px/1.3 monospace;white-space:pre-wrap;z-index:99999;display:none;-webkit-user-select:text;user-select:text;';
+    document.body.appendChild(panel);
+  }
+  function render() {
+    ensure();
+    if (!panel) { return; }
+    panel.textContent = lines.slice(-80).join(NL);
+    panel.scrollTop = panel.scrollHeight;
+  }
+  function show() { open = true; ensure(); if (panel) { panel.style.display = 'block'; render(); } }
+  function fmt(a) {
+    try { return typeof a === 'string' ? a : (a && a.stack) || JSON.stringify(a); } catch (e) { return String(a); }
+  }
+  function push(tag, args) {
+    lines.push(tag + ' ' + Array.prototype.map.call(args, fmt).join(' '));
+    if (lines.length > 400) { lines.shift(); }
+    if (open) { render(); }
+  }
+  ['log', 'info', 'warn', 'error'].forEach(function (k) {
+    var orig = console[k];
+    console[k] = function () {
+      push(k === 'error' ? 'E' : k === 'warn' ? 'W' : '.', arguments);
+      for (var i = 0; i < arguments.length; i++) { if (arguments[i] instanceof Error) { show(); } }
+      return orig.apply(console, arguments);
+    };
+  });
+  window.addEventListener('error', function (e) { push('E', [e.message + ' @' + e.filename + ':' + e.lineno]); show(); });
+  window.addEventListener('unhandledrejection', function (e) { push('E', ['promise: ' + fmt(e.reason)]); show(); });
+  if (location.search.indexOf('debug') >= 0) { document.addEventListener('DOMContentLoaded', show); }
+})();
+</script>
+<style>
+#smb-rotate, #smb-import { position: fixed; left: 0; top: 0; right: 0; bottom: 0; display: none; align-items: center; justify-content: center; flex-direction: column; box-sizing: border-box; padding: 24px; text-align: center; color: #fff; font: bold 14px/1.6 monospace; text-transform: uppercase; letter-spacing: 1px; -webkit-user-select: none; user-select: none; }
+#smb-rotate { z-index: 100001; background: #000; touch-action: none; font: 20px/1.4 -apple-system, Helvetica, Arial, sans-serif; text-transform: none; letter-spacing: 0; }
+#smb-import { z-index: 100000; background: rgba(0, 0, 0, 0.82); }
+html.smb-portrait canvas { visibility: hidden; }
+#smb-card { width: 100%; max-width: 360px; padding: 18px 16px; background: #111; border: 3px solid #fff; border-radius: 6px; box-sizing: border-box; }
+#smb-title { font-size: 16px; margin-bottom: 8px; }
+#smb-msg { font-size: 11px; opacity: 0.85; margin-bottom: 14px; min-height: 18px; }
+.smb-btn { position: relative; display: block; margin: 8px 0 0; padding: 14px 8px; background: #fff; color: #000; border-radius: 4px; overflow: hidden; cursor: pointer; }
+.smb-btn.sec { background: #333; color: #fff; }
+.smb-btn input { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; font-size: 200px; }
+</style>
+<script>
+(function () {
+  var ready = false, rot = null, ov = null, ttl = null, msg = null, pick = null, fileIn = null, ok = null, cancel = null;
+  var st = { kind: '', buf: null, len: 0, max: 0, reload: 0 };
+  var CH = 393216;
+
+  function isTouchDevice() {
+    var coarse = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
+    var ua = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent || '');
+    var ipadOs = (navigator.platform === 'MacIntel') && (navigator.maxTouchPoints || 0) > 1;
+    return !!(coarse || ua || ipadOs);
+  }
+  function updatePortrait() {
+    var p = isTouchDevice() && window.innerHeight > window.innerWidth;
+    window.smbPortrait = p;
+    document.documentElement.classList.toggle('smb-portrait', p);
+    if (rot) { rot.style.display = p ? 'flex' : 'none'; }
+  }
+
+  function notify(evt, name, extra) {
+    var cb = window.smbImportCallback;
+    if (typeof cb === 'function') { cb(evt, st.kind, name || '', extra === undefined ? '' : extra); }
+  }
+  function show(busy) {
+    ov.style.display = 'flex';
+    pick.style.display = busy ? 'none' : 'block';
+    cancel.style.display = busy ? 'none' : 'block';
+    ok.style.display = 'none';
+  }
+  function hide() { if (ov) { ov.style.display = 'none'; } }
+  function release() { st.buf = null; st.len = 0; }
+
+  function build() {
+    if (ready || !document.body) { return; }
+    ready = true;
+    rot = document.createElement('div');
+    rot.id = 'smb-rotate';
+    rot.textContent = 'Please rotate your device';
+    document.body.appendChild(rot);
+    ov = document.createElement('div');
+    ov.id = 'smb-import';
+    ov.innerHTML = '<div id=\"smb-card\"><div id=\"smb-title\"></div><div id=\"smb-msg\"></div>' +
+      '<div class=\"smb-btn\" id=\"smb-pick\">Choose .zip file<input id=\"smb-file\" type=\"file\" accept=\".zip,application/zip,application/x-zip-compressed\"></div>' +
+      '<div class=\"smb-btn\" id=\"smb-ok\">OK</div>' +
+      '<div class=\"smb-btn sec\" id=\"smb-cancel\">Cancel</div></div>';
+    document.body.appendChild(ov);
+    ttl = document.getElementById('smb-title');
+    msg = document.getElementById('smb-msg');
+    pick = document.getElementById('smb-pick');
+    fileIn = document.getElementById('smb-file');
+    ok = document.getElementById('smb-ok');
+    cancel = document.getElementById('smb-cancel');
+
+    cancel.addEventListener('click', function () { hide(); notify('cancel'); });
+    ok.addEventListener('click', function () { hide(); });
+    fileIn.addEventListener('cancel', function () { hide(); notify('cancel'); });
+    fileIn.addEventListener('change', function () {
+      var f = fileIn.files && fileIn.files[0];
+      if (!f) { return; }
+      if (f.size > st.max) {
+        fileIn.value = '';
+        msg.textContent = 'That file is too large (max ' + Math.floor(st.max / 1048576) + ' MB).';
+        notify('error', f.name, 'too_large');
+        return;
+      }
+      show(true);
+      msg.textContent = 'Reading file...';
+      var reader = new FileReader();
+      reader.onerror = function () {
+        show(false);
+        msg.textContent = 'Could not read that file.';
+        notify('error', f.name, 'read_error');
+      };
+      reader.onload = function () {
+        st.buf = reader.result;
+        st.len = reader.result.byteLength;
+        fileIn.value = '';
+        notify('file', f.name, st.len);
+      };
+      reader.readAsArrayBuffer(f);
+    });
+    updatePortrait();
+  }
+
+  window.smbImporter = {
+    prompt: function (kind, title, hint, maxBytes) {
+      build();
+      if (!ov) { return; }
+      st.kind = kind; st.max = maxBytes || 0;
+      ttl.textContent = title;
+      msg.textContent = hint;
+      show(false);
+    },
+    status: function (text) { if (ov) { show(true); msg.textContent = text; } },
+    finish: function (text, success, reloadMs) {
+      build();
+      if (!ov) { return; }
+      ov.style.display = 'flex';
+      pick.style.display = 'none';
+      cancel.style.display = 'none';
+      msg.textContent = text;
+      if (reloadMs > 0) {
+        ok.style.display = 'none';
+        setTimeout(function () { window.location.reload(); }, reloadMs);
+      } else {
+        ok.style.display = 'block';
+      }
+    },
+    chunk: function (i) {
+      if (!st.buf) { return null; }
+      var s = i * CH, e = Math.min(s + CH, st.len);
+      var bytes = new Uint8Array(st.buf, s, e - s);
+      var bin = '';
+      for (var j = 0; j < bytes.length; j += 0x2000) {
+        bin += String.fromCharCode.apply(null, bytes.subarray(j, Math.min(j + 0x2000, bytes.length)));
+      }
+      return btoa(bin);
+    },
+    release: release
+  };
+
+  window.addEventListener('resize', updatePortrait);
+  window.addEventListener('orientationchange', function () { updatePortrait(); setTimeout(updatePortrait, 150); setTimeout(updatePortrait, 500); });
+  document.addEventListener('DOMContentLoaded', build);
+  updatePortrait();
+})();
+</script>"
