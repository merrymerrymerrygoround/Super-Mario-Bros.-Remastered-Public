diff --git a/Scripts/UI/WebImporter.gd b/Scripts/UI/WebImporter.gd
new file mode 100644
index 0000000..312c8b5
--- /dev/null
+++ b/Scripts/UI/WebImporter.gd
@@ -0,0 +1,337 @@
+class_name WebImporter
+extends Node
+## File browser for resource packs and mods (Web export only).
+##
+## The page (export_presets.cfg head_include) provides window.smbImporter: a modal file
+## browser drawn in HTML on top of the game (path bar, Refresh, Import file..., and an
+## actions menu per item). Godot owns the files; the page only asks for things through
+## window.smbImportCallback, and Godot answers by calling back into window.smbImporter:
+##   "list"   (dir)             -> setListing: show a folder
+##   "file"   (dir, name, size) -> import the picked .zip into that folder
+##   "delete" (dir, name)       -> delete an item
+##   "close"                    -> the player left the browser
+##
+## It is HTML (not Godot controls) because iOS Safari only opens a file chooser from a
+## genuine tap on the page, never from a Godot Button press.
+##
+## Folders: "" (the root, listing the two below), "mods" (zips kept in user://mods) and
+## "resource_packs" (one folder per pack). Mods load at startup, so any mod change
+## reloads the page when the player leaves the browser.
+##
+## A picked file stays in the page. We pull it across in base64 chunks (so big zips never
+## need one giant string), write it to a temp file in user://, then install it.
+
+signal packs_changed
+
+const MAX_BYTES := 96 * 1024 * 1024
+## Must match CH in the page script, and be a multiple of 3 so each chunk is clean base64.
+const CHUNK_BYTES := 393216
+const TMP_PATH := "user://import_tmp.zip"
+const MODS_DIR := "user://mods"
+const ROOT_DIRS := ["mods", "resource_packs"]
+
+var _callback: JavaScriptObject = null
+var _busy := false
+## Milliseconds to wait before reloading when the browser closes (0 = no reload needed).
+var _reload_ms := 0
+
+
+## dir: "" (root), "mods" or "resource_packs"
+func open(dir := "") -> void:
+	if not OS.has_feature("web") or _busy:
+		return
+	DirAccess.make_dir_recursive_absolute(MODS_DIR)
+	DirAccess.make_dir_recursive_absolute(_packs_dir())
+	_connect()
+	var shown := dir if dir in ROOT_DIRS else ""
+	JavaScriptBridge.eval("window.smbImporter.open(%s, %s, %d);" % [
+		JSON.stringify(shown), JSON.stringify(_listing(shown)), MAX_BYTES], true)
+
+
+## Deletes every imported mod and reloads the page (recovery if a mod misbehaves).
+func remove_all_mods() -> void:
+	if not OS.has_feature("web"):
+		return
+	var removed := 0
+	for f in DirAccess.get_files_at(MODS_DIR):
+		if f.to_lower().ends_with(".zip"):
+			DirAccess.remove_absolute(MODS_DIR.path_join(f))
+			removed += 1
+	_connect()
+	var msg := "Removed %d mod%s. Reloading..." % [removed, "" if removed == 1 else "s"]
+	_finish(true, msg, 1500)
+
+
+func _connect() -> void:
+	if _callback == null:
+		_callback = JavaScriptBridge.create_callback(_on_js_event)
+	JavaScriptBridge.get_interface("window").smbImportCallback = _callback
+
+
+func _on_js_event(args: Array) -> void:
+	var evt := str(args[0]) if args.size() > 0 else ""
+	var dir := str(args[1]) if args.size() > 1 else ""
+	var item := str(args[2]) if args.size() > 2 else ""
+	if _busy and evt != "error":
+		return
+	match evt:
+		"list":
+			_show_dir.call_deferred(dir)
+		"file":
+			_receive.call_deferred(dir, item, int(args[3]))
+		"delete":
+			_delete.call_deferred(dir, item)
+		"close":
+			_closed.call_deferred()
+		"error":
+			_play("bump")
+
+
+# --- Listing -----------------------------------------------------------------
+
+func _packs_dir() -> String:
+	return Global.config_path.path_join("resource_packs")
+
+
+## Items for the page: {"n": name, "t": "dir" | "zip" | "pack", "s": size in bytes}.
+func _listing(dir: String) -> Array:
+	var items := []
+	match dir:
+		"":
+			for d in ROOT_DIRS:
+				items.append({"n": d, "t": "dir"})
+		"mods":
+			var files := DirAccess.get_files_at(MODS_DIR)
+			files.sort()
+			for f in files:
+				if f.to_lower().ends_with(".zip"):
+					items.append({"n": f, "t": "zip", "s": _file_size(MODS_DIR.path_join(f))})
+		"resource_packs":
+			var dirs := DirAccess.get_directories_at(_packs_dir())
+			dirs.sort()
+			for d in dirs:
+				if d != Global.ROM_PACK_NAME: # the generated base assets are not a user pack
+					items.append({"n": d, "t": "pack", "s": _dir_size(_packs_dir().path_join(d))})
+	return items
+
+
+func _file_size(path: String) -> int:
+	var f := FileAccess.open(path, FileAccess.READ)
+	return f.get_length() if f != null else 0
+
+
+func _dir_size(path: String) -> int:
+	var total := 0
+	for f in DirAccess.get_files_at(path):
+		total += _file_size(path.path_join(f))
+	for d in DirAccess.get_directories_at(path):
+		total += _dir_size(path.path_join(d))
+	return total
+
+
+func _show_dir(dir: String) -> void:
+	_push_listing(dir if dir in ROOT_DIRS else "", "", true)
+
+
+func _push_listing(dir: String, message: String, ok: bool) -> void:
+	JavaScriptBridge.eval("window.smbImporter.setListing(%s, %s, %s, %s);" % [
+		JSON.stringify(dir), JSON.stringify(_listing(dir)), JSON.stringify(message),
+		"true" if ok else "false"], true)
+
+
+# --- Import ------------------------------------------------------------------
+
+func _receive(dir: String, file_name: String, size: int) -> void:
+	if not dir in ROOT_DIRS:
+		_push_listing("", "Open the mods or resource_packs folder first.", false)
+		return
+	_busy = true
+	_status("Reading file...")
+	var out := FileAccess.open(TMP_PATH, FileAccess.WRITE)
+	if out == null:
+		_fail(dir, "Could not write to browser storage.")
+		return
+	var chunks := ceili(float(size) / CHUNK_BYTES)
+	for i in chunks:
+		var b64: Variant = JavaScriptBridge.eval("window.smbImporter.chunk(%d)" % i, true)
+		if typeof(b64) != TYPE_STRING:
+			out.close()
+			_cleanup()
+			_fail(dir, "Could not read the file. Try again.")
+			return
+		out.store_buffer(Marshalls.base64_to_raw(b64))
+		if i % 8 == 7:
+			_status("Copying... %d%%" % int(100.0 * (i + 1) / chunks))
+			await get_tree().process_frame
+	out.close()
+	JavaScriptBridge.eval("window.smbImporter.release();", true)
+	_status("Installing...")
+	await get_tree().process_frame
+
+	var result: Dictionary
+	if dir == "mods":
+		result = install_mod(TMP_PATH, file_name)
+	else:
+		result = install_resource_pack(TMP_PATH, file_name)
+	_cleanup()
+
+	var ok: bool = result.get("ok", false)
+	if ok and dir == "mods":
+		# Give the browser time to persist user:// to IndexedDB before reloading.
+		_reload_ms = maxi(_reload_ms, 1500 + int(size / 1048576.0 * 60.0))
+	_busy = false
+	_play("coin" if ok else "bump")
+	_push_listing(dir, str(result.get("message", "")), ok)
+	if ok and dir == "resource_packs":
+		packs_changed.emit()
+
+
+func _fail(dir: String, message: String) -> void:
+	_busy = false
+	_play("bump")
+	_push_listing(dir, message, false)
+
+
+# --- Delete ------------------------------------------------------------------
+
+func _delete(dir: String, item: String) -> void:
+	# Only plain names that are really in the folder; never a path.
+	var known := false
+	for entry in _listing(dir):
+		if entry["n"] == item and entry["t"] != "dir":
+			known = true
+	if not known or item.get_file() != item:
+		_push_listing(dir, "That item is not there any more.", false)
+		return
+	if dir == "mods":
+		DirAccess.remove_absolute(MODS_DIR.path_join(item))
+		_reload_ms = maxi(_reload_ms, 1500)
+		_push_listing(dir, "Removed \"%s\". It unloads when the game reloads." % item, true)
+	else:
+		Global.trash_or_delete(_packs_dir().path_join(item))
+		_push_listing(dir, "Removed pack \"%s\"." % item, true)
+		packs_changed.emit()
+	_play("coin")
+
+
+func _closed() -> void:
+	if _reload_ms > 0:
+		var ms := _reload_ms
+		_reload_ms = 0
+		_finish(true, "Reloading to apply mod changes...", ms)
+
+
+# --- Helpers -----------------------------------------------------------------
+
+func _status(text: String) -> void:
+	JavaScriptBridge.eval("window.smbImporter.status(%s);" % JSON.stringify(text), true)
+
+
+func _finish(ok: bool, message: String, reload_ms := 0) -> void:
+	_busy = false
+	_play("coin" if ok else "bump")
+	JavaScriptBridge.eval("window.smbImporter.finish(%s, %s, %d);" % [
+		JSON.stringify(message), "true" if ok else "false", reload_ms], true)
+
+
+func _play(sfx: String) -> void:
+	AudioManager.play_global_sfx(sfx)
+
+
+func _cleanup() -> void:
+	if FileAccess.file_exists(TMP_PATH):
+		DirAccess.remove_absolute(TMP_PATH)
+
+
+static func _err(message: String) -> Dictionary:
+	return {"ok": false, "message": message}
+
+
+## Keeps letters, digits, space, dot, dash and underscore.
+static func _sanitize(text: String) -> String:
+	var out := ""
+	for ch in text:
+		var code := ch.unicode_at(0)
+		var keep := (code >= 48 and code <= 57) or (code >= 65 and code <= 90) \
+				or (code >= 97 and code <= 122) or ch in [" ", ".", "-", "_"]
+		out += ch if keep else "_"
+	return out.strip_edges().lstrip(".")
+
+
+static func install_resource_pack(zip_path: String, file_name: String) -> Dictionary:
+	var zip := ZIPReader.new()
+	if zip.open(zip_path) != OK:
+		return _err("Not a valid zip file.")
+	var files := zip.get_files()
+
+	# Find the shallowest pack_info.json: the pack is either at the zip root or
+	# inside one folder (the usual result of zipping a folder).
+	var info_path := ""
+	for f in files:
+		if f.begins_with("__MACOSX/") or f.get_file() != "pack_info.json":
+			continue
+		if info_path == "" or f.count("/") < info_path.count("/"):
+			info_path = f
+	if info_path == "":
+		zip.close()
+		return _err("Not a resource pack: no pack_info.json found.")
+
+	var prefix := info_path.get_base_dir() # "" when at the root
+	var pack_id := _sanitize(prefix.get_file() if prefix != "" else file_name.get_basename())
+	if pack_id == "" or pack_id == Global.ROM_PACK_NAME:
+		pack_id = "imported_pack"
+	var dest_root: String = Global.config_path.path_join("resource_packs").path_join(pack_id)
+	if DirAccess.dir_exists_absolute(dest_root):
+		Global.trash_or_delete(dest_root) # re-importing replaces the old copy
+
+	var written := 0
+	for f in files:
+		if f.ends_with("/") or f.begins_with("__MACOSX/") or f.get_file() == ".DS_Store":
+			continue
+		var rel := f
+		if prefix != "":
+			if not f.begins_with(prefix + "/"):
+				continue
+			rel = f.substr(prefix.length() + 1)
+		if rel == "" or rel.begins_with("/") or ".." in rel.split("/"):
+			continue # never write outside the pack folder
+		var dest: String = dest_root.path_join(rel)
+		DirAccess.make_dir_recursive_absolute(dest.get_base_dir())
+		var out := FileAccess.open(dest, FileAccess.WRITE)
+		if out == null:
+			zip.close()
+			return _err("Could not write " + rel.get_file() + ".")
+		out.store_buffer(zip.read_file(f))
+		out.close()
+		written += 1
+	zip.close()
+
+	if written == 0:
+		return _err("The pack was empty.")
+	return {"ok": true, "pack_id": pack_id,
+			"message": "Added pack \"%s\" (%d files)." % [pack_id, written]}
+
+
+static func install_mod(zip_path: String, file_name: String) -> Dictionary:
+	var zip := ZIPReader.new()
+	if zip.open(zip_path) != OK:
+		return _err("Not a valid zip file.")
+	var has_manifest := false
+	for f in zip.get_files():
+		if f.begins_with("mods-unpacked/") and f.get_file() == "manifest.json":
+			has_manifest = true
+			break
+	zip.close()
+	if not has_manifest:
+		return _err("Not a mod: no mods-unpacked manifest found.")
+
+	var zip_name := _sanitize(file_name.get_file())
+	if not zip_name.to_lower().ends_with(".zip"):
+		zip_name += ".zip"
+	DirAccess.make_dir_recursive_absolute(MODS_DIR)
+	var dest := MODS_DIR.path_join(zip_name)
+	if FileAccess.file_exists(dest):
+		DirAccess.remove_absolute(dest)
+	if DirAccess.copy_absolute(zip_path, dest) != OK:
+		return _err("Could not save the mod.")
+	return {"ok": true, "message": "Added mod \"%s\". It loads when the game reloads." % zip_name}
diff --git a/Scripts/UI/WebRomPicker.gd b/Scripts/UI/WebRomPicker.gd
new file mode 100644
index 0000000..3eee48f
--- /dev/null
+++ b/Scripts/UI/WebRomPicker.gd
@@ -0,0 +1,107 @@
+class_name WebRomPicker
+extends RefCounted
+## Browser ROM picker for the Web export (iOS Safari friendly).
+##
+## iOS Safari only opens a file picker if input.click() runs inside the user's
+## tap handler. Godot's Button.pressed fires later (next engine frame), which
+## Safari rejects, so the hidden <input type="file"> is opened from a DOM-level
+## touchend/pointerup/click listener while the picker is "armed". The chosen
+## file is read in JS and handed to Godot as base64 through a JS callback.
+
+signal rom_loaded(file_name: String, data: PackedByteArray)
+signal rom_rejected(reason: String) ## "too_large" or "read_error"
+signal picker_cancelled
+
+const MAX_ROM_BYTES := 2 * 1024 * 1024
+
+const JS_SETUP := """
+(function () {
+	if (window.smbRomPicker) { return; }
+	var MAX = %d;
+	var input = document.createElement('input');
+	input.type = 'file';
+	input.accept = '.nes,application/octet-stream';
+	input.setAttribute('aria-hidden', 'true');
+	input.style.cssText = 'position:fixed;left:0;top:0;width:1px;height:1px;opacity:0;pointer-events:none;';
+	document.body.appendChild(input);
+
+	var picker = { armed: false, lastOpen: 0 };
+
+	function notify(kind, a, b) {
+		var cb = window.smbRomPickerCallback;
+		if (typeof cb === 'function') { cb(kind, a || '', b || ''); }
+	}
+
+	picker.open = function () {
+		var now = Date.now();
+		if (now - picker.lastOpen < 800) { return; }
+		picker.lastOpen = now;
+		input.click();
+	};
+	picker.arm = function () { picker.armed = true; };
+	picker.disarm = function () { picker.armed = false; };
+
+	input.addEventListener('change', function () {
+		var file = input.files && input.files[0];
+		if (!file) { notify('cancel'); return; }
+		if (file.size > MAX) { input.value = ''; notify('too_large', file.name); return; }
+		var reader = new FileReader();
+		reader.onerror = function () { notify('read_error', file.name); };
+		reader.onload = function () {
+			var bytes = new Uint8Array(reader.result);
+			var bin = '';
+			for (var i = 0; i < bytes.length; i += 0x8000) {
+				bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
+			}
+			input.value = '';
+			notify('file', file.name, btoa(bin));
+		};
+		reader.readAsArrayBuffer(file);
+	});
+	input.addEventListener('cancel', function () { notify('cancel'); });
+
+	['touchend', 'pointerup', 'click'].forEach(function (type) {
+		window.addEventListener(type, function () {
+			if (picker.armed) { picker.open(); }
+		}, true);
+	});
+	window.smbRomPicker = picker;
+})();
+""" % MAX_ROM_BYTES
+
+var _js_callback: JavaScriptObject = null
+
+
+func start() -> bool:
+	if not OS.has_feature("web"):
+		return false
+	JavaScriptBridge.eval(JS_SETUP, true)
+	_js_callback = JavaScriptBridge.create_callback(_on_js_event)
+	JavaScriptBridge.get_interface("window").smbRomPickerCallback = _js_callback
+	JavaScriptBridge.eval("window.smbRomPicker.arm();", true)
+	return true
+
+
+func stop() -> void:
+	if _js_callback == null:
+		return
+	JavaScriptBridge.eval("if (window.smbRomPicker) { window.smbRomPicker.disarm(); } window.smbRomPickerCallback = null;", true)
+	_js_callback = null
+
+
+## Fallback for browsers that allow opening the picker outside a DOM gesture
+## (desktop). On iOS the armed DOM listener does the real work.
+func open_now() -> void:
+	if OS.has_feature("web"):
+		JavaScriptBridge.eval("if (window.smbRomPicker) { window.smbRomPicker.open(); }", true)
+
+
+func _on_js_event(args: Array) -> void:
+	var kind := str(args[0]) if args.size() > 0 else ""
+	match kind:
+		"file":
+			rom_loaded.emit(str(args[1]), Marshalls.base64_to_raw(str(args[2])))
+		"too_large", "read_error":
+			rom_rejected.emit(kind)
+		"cancel":
+			picker_cancelled.emit()
diff --git a/WEB_BUILD.md b/WEB_BUILD.md
new file mode 100644
index 0000000..95736f8
--- /dev/null
+++ b/WEB_BUILD.md
@@ -0,0 +1,33 @@
+# Web (iOS Safari) build
+
+Build: run the **web build** workflow from the GitHub Actions tab (works from a phone). Download the `web` artifact, or tick *deploy_pages* to publish to GitHub Pages. Locally: `godot --headless --export-release "Web" build/web/index.html`.
+
+First launch: tap **BROWSE FILES...**, pick your vanilla SMB1 `.nes` from the Files app. The ROM and generated assets are stored in the browser's IndexedDB (`user://`); keep the site added to the Home Screen so iOS doesn't evict storage.
+
+## Touch controls
+
+Shown automatically on touch devices and hidden while a gamepad is connected or used. They are laid out from the real visible area, so they stay at the screen edges and keep a thumb-friendly size for every **Size** setting, window shape and per-level resolution. Set `always_show` on the `TouchControls` autoload to test on desktop.
+
+**Customize layout:** Settings → Video → **CUSTOMIZE TOUCH LAYOUT** opens an editor. Drag any control to move it, tap one and use **+ / -** to resize it (tap empty space first to resize them all), **RESET** restores the default, **DONE** saves. The layout is stored in the browser next to your save data.
+
+**LOCK** (above B) is the run lock ("shift lock"): tap once to hold run on, tap again to release. B still fires fireballs while locked.
+
+## Portrait mode
+
+On phones/tablets held upright the page shows a "please rotate your device" screen, and the game is paused and muted until the device is in landscape. Desktop browsers are never blocked.
+
+## Importing resource packs and mods
+
+Settings > Resource Packs has **BROWSE RESOURCE PACKS** and **BROWSE MODS**. Both open the in-page **File Browser** (HTML drawn over the game, so the Files app opens from a real tap):
+
+- The path bar starts at **AppData**, which holds two folders: `mods` and `resource_packs`. Tap a folder to open it, **Up** or **AppData** to go back, **Refresh** to re-read it.
+- **Import file...** (inside `mods` or `resource_packs`) picks a `.zip` from the Files app. A resource pack zip needs a `pack_info.json` (at the root or inside one folder) and is unpacked into the browser's storage. A mod zip is a Godot Mod Loader zip with a `mods-unpacked/<Mod>/manifest.json`.
+- **...** on a row opens the actions menu (delete).
+- **Return to Options** closes the browser. Mods load at startup, so if you added or removed a mod the page reloads at that point to apply it (import as many as you like first).
+- **REMOVE ALL MODS** (in the menu, press twice) still deletes every mod and reloads.
+
+Safe mode: if an imported mod stops the game from starting, open the site with `?nomods` on the end of the address (e.g. `https://you.github.io/repo/?nomods`), then use REMOVE ALL MODS.
+
+Files up to 96 MB are accepted. Mods are not loaded at all until you import one.
+
+Notes: single-threaded export (no SharedArrayBuffer/COOP/COEP needed); GDExtensions (Discord RPC, godotgif) are disabled on Web.
diff --git a/addons/mod_loader/mod_loader.gd b/addons/mod_loader/mod_loader.gd
index 5ce020f..aada591 100644
--- a/addons/mod_loader/mod_loader.gd
+++ b/addons/mod_loader/mod_loader.gd
@@ -32,6 +32,10 @@ const LOG_NAME := "ModLoader"
 
 
 func _init() -> void:
+	# Web: only runs when mods were imported (see ModLoaderStore._init).
+	if OS.has_feature("web") and not ModLoaderStore.ml_options.enable_mods:
